# Apptainer image of this project, made from the Docker image (lesson 08).
# Build on Linux (or WSL2, or the cluster) after pushing the Docker image:
#   apptainer build containers/acmg-af-sarcomere.sif containers/apptainer.def
# Or straight from a local Docker image, without this file:
#   apptainer build containers/acmg-af-sarcomere.sif docker-daemon://acmg-af-sarcomere:0.1.0
Bootstrap: docker
From: ghcr.io/911vader/acmg-af-sarcomere:0.1.0

%runscript
    exec /entrypoint.sh "$@"

%labels
    Project acmg-af-sarcomere
